{
  "manifest_version": 3,
  "name": "Sorsa Score",
  "version": "1.0.0",
  "description": "View Sorsa Score directly beside X usernames.",
  "permissions": [],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://sorsas-score-backend.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Sorsa Score"
  }
}
